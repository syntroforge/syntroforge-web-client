{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "syntroforge-web-client",
  "version": "0.0.1-dev",
  "private": true,
  "description": "SyntroForge OT device management web client",
  "keywords": [
    "device management",
    "web client"
  ],
  "homepage": "https://syntroforge.io",
  "bugs": {
    "url": "https://github.com/syntroforge/syntroforge-web-client/issues"
  },
  "license": "Apache-2.0 OR MIT",
  "author": {
    "name": "Martin Dickopp",
    "email": "martin@syntroforge.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntroforge/syntroforge-web-client.git"
  },
  "type": "module",
  "browser": "index.html",
  "scripts": {
    "format": "oxfmt",
    "lint": "pnpm run lint:format && pnpm run lint:typescript",
    "lint:format": "oxfmt --check",
    "lint:typescript": "tsc --build",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.2",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "html-minifier-terser": "^7.2.0",
    "oxfmt": "^0.60.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
