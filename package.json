{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "syntroforge-web-client",
  "version": "0.0.1-dev",
  "private": true,
  "description": "SyntroForge OT device management web client",
  "keywords": [
    "device management",
    "web client"
  ],
  "homepage": "https://syntroforge.io",
  "bugs": {
    "url": "https://github.com/syntroforge/syntroforge-web-client/issues"
  },
  "license": "Apache-2.0 OR MIT",
  "author": {
    "name": "Martin Dickopp",
    "email": "martin@syntroforge.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntroforge/syntroforge-web-client.git"
  },
  "type": "module",
  "browser": "index.html",
  "scripts": {
    "format": "oxfmt",
    "lint": "pnpm run lint:format",
    "lint:format": "oxfmt --check",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "oxfmt": "^0.59.0",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
