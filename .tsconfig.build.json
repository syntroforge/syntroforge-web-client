{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["es2025"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "node_modules/.tsbuildinfo.build.json",
    "types": ["node"]
  },
  "include": ["*.ts", "build/**/*.tsx"]
}
