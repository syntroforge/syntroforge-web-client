{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "syntroforge-web-client",
  "version": "0.0.1-dev",
  "private": true,
  "description": "SyntroForge OT device management web client",
  "keywords": [
    "device management",
    "web client"
  ],
  "homepage": "https://syntroforge.io",
  "bugs": {
    "url": "https://github.com/syntroforge/syntroforge-web-client/issues"
  },
  "license": "Apache-2.0 OR MIT",
  "author": {
    "name": "Martin Dickopp",
    "email": "martin@syntroforge.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntroforge/syntroforge-web-client.git"
  },
  "type": "module",
  "browser": "index.html",
  "scripts": {
    "format": "oxfmt",
    "check": "pnpm run check:spelling && pnpm run check:formatting && pnpm run check:lint && pnpm run check:markdown",
    "check:spelling": "typos",
    "check:formatting": "oxfmt --check",
    "check:lint": "oxlint --deny-warnings",
    "check:markdown": "markdownlint .",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.1.2",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "eslint-plugin-solid": "^0.14.5",
    "html-minifier-terser": "^7.2.0",
    "markdownlint-cli": "^0.49.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
